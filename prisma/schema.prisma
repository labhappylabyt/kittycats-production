generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  Profile   Profile?
}

model Profile {
  id          String  @id @default(uuid())
  userId      String  @unique
  username    String  @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  treatCount  Int     @default(0)
  Link        Link[]
  user        User    @relation(fields: [userId], references: [id])
}

model Link {
  id         String  @id @default(uuid())
  title      String
  url        String
  icon       String?
  orderIndex Int
  profileId  String
  profile    Profile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}
